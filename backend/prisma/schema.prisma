generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int             @id @default(autoincrement())
  email        String          @unique
  passwordHash String
  name         String
  vibeTag      String?         @unique
  role         String          @default("student")
  avatar       String?
  major        String?
  year         String?
  anonymousDefault Boolean     @default(true)
  nudges       Boolean         @default(true)
  nightMode    Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     Session[]
  checkIns     CheckIn[]
  chatMessages ChatMessage[]
  chatSessions ChatSession[]
  posts        Post[]         @relation("PostAuthor")
  comments     Comment[]
  ownedPosts   Post[]         @relation("PostOwner")
  enrollments  Enrollment[]
  submissions  Submission[]
  attendance   AttendanceRecord[]
  clubMembers  ClubMember[]
  clubMessages ClubMessage[]
  ownedClubs   Club[]
  postVotes    PostVote[]
  coursesTaught      Course[]              @relation("CourseInstructor")
  auditLogsWritten   AuditLog[]            @relation("AuditActor")
  auditLogsAgainst   AuditLog[]            @relation("AuditTarget")
  referralsRaised    WellbeingReferral[]   @relation("ReferralRaisedBy")
  referralsReceived  WellbeingReferral[]   @relation("ReferralStudent")
}

/// Every time staff read a student's academic or wellbeing data, so that
/// access to sensitive student records is attributable and reviewable.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  targetId  Int?
  target    User?    @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)
  scope     String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetId])
}

/// A teacher's "this student may need support" flag. Deliberately carries no
/// wellbeing score: the teacher sees the ask, staff with safeguarding duty
/// resolve it.
model WellbeingReferral {
  id         Int       @id @default(autoincrement())
  studentId  Int
  student    User      @relation("ReferralStudent", fields: [studentId], references: [id], onDelete: Cascade)
  courseId   Int?
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  raisedById Int
  raisedBy   User      @relation("ReferralRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  reason     String
  note       String?
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  // Deliberately NOT unique on (studentId, courseId, raisedById). That would
  // make a referral permanent: once a case is closed the teacher could never
  // raise a new concern about the same student in the same course, even after
  // the student has relapsed. It is also wrong for the nullable courseId, since
  // SQL treats NULLs as distinct and the index would never fire. The "one open
  // referral per student/course/raiser" rule is enforced in the route instead,
  // which can scope it to status = 'open'.
  @@index([studentId, courseId, raisedById, status])
  @@index([status])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CheckIn {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  mood      String
  text      String?
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        Int          @id @default(autoincrement())
  userId    Int?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId Int?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  role      String
  content   String
  intent    String?
  riskLevel String?
  /// Retrieved textbook passages that grounded this reply (JSON array), so the
  /// source behind an academic answer can be shown and verified after the fact.
  sources   String?
  createdAt DateTime @default(now())
}

model ChatSession {
  id             Int           @id @default(autoincrement())
  userId         Int?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  title          String        @default("New chat")
  intent         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       ChatMessage[]
}

model KnowledgeChunk {
  id         Int      @id @default(autoincrement())
  source     String
  collection String   @default("mental_health")
  category   String
  title      String
  text       String
  embedding  String
  tokens     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([collection, category])
}

model Course {
  id          Int           @id @default(autoincrement())
  name        String
  code        String        @unique
  credits     Int           @default(3)
  instructor  String?
  /// FK to the teaching staff account. `instructor` is a free-text display
  /// name kept for import compatibility; authorisation uses this column.
  instructorId Int?
  instructorUser User?    @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  color       String?
  attendance  Int?
  grade       Int?
  letter      String?
  enrollments Enrollment[]
  quizzes     Quiz[]
  submissions Submission[]
  assignments Assignment[]
  sessions    ClassSession[]
  referrals   WellbeingReferral[]
}

model ClassSession {
  id        Int                @id @default(autoincrement())
  courseId  Int
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date      String
  createdAt DateTime           @default(now())
  records   AttendanceRecord[]

  @@unique([courseId, date])
}

model AttendanceRecord {
  id        Int          @id @default(autoincrement())
  sessionId Int
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  present   Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@unique([sessionId, userId])
}

model Quiz {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  date     String?
  daysLeft Int    @default(0)
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  ia1        Int?
  ia2        Int?
  attendance Int?
  createdAt  DateTime @default(now())

  @@unique([userId, courseId])
}

model Assignment {
  id            Int          @id @default(autoincrement())
  courseId      Int
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  due           String?
  instructions  String?
  pdfName       String?
  pdfStoredAs   String?
  pdfMime       String?
  pdfSize       Int?
  createdAt     DateTime     @default(now())
  submissions   Submission[]

  @@index([courseId])
}

model Submission {
  id           Int        @id @default(autoincrement())
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     Int
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  type         String     @default("assignment")
  score        Float?
  notes        String?
  fileName     String?
  fileStoredAs String?
  fileMime     String?
  fileSize     Int?
  gradedAt     DateTime?
  feedback     String?
  createdAt    DateTime   @default(now())

  @@unique([userId, assignmentId])
  @@index([assignmentId])
}

model Post {
  id         Int       @id @default(autoincrement())
  authorId   Int?
  author     User?     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String    @default("Anonymous")
  anonymous  Boolean   @default(true)
  ownerId    Int?
  owner      User?     @relation("PostOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  category   String
  title      String
  body       String
  upvotes    Int       @default(0)
  createdAt  DateTime  @default(now())
  comments   Comment[]
  votes      PostVote[]
}

model PostVote {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id         Int      @id @default(autoincrement())
  postId     Int
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   Int?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String   @default("Anonymous")
  body       String
  createdAt  DateTime @default(now())
}

model Club {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  members     Int          @default(0)
  tags        String       @default("[]")
  accent      String?
  banner      String?
  ownerId     Int?
  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  memberships ClubMember[]
  messages    ClubMessage[]
}

model ClubMessage {
  id        Int      @id @default(autoincrement())
  clubId    Int
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  author    String   @default("Anonymous")
  body      String
  createdAt DateTime @default(now())
}

model ClubMember {
  id        Int      @id @default(autoincrement())
  clubId    Int
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([clubId, userId])
}